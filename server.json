{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.uberllm/mcp",
  "title": "UberLLM",
  "description": "Make images and videos, price requests, list AI models and read your balance, from one API key.",
  "version": "1.0.0",
  "websiteUrl": "https://uberllm.dev/docs/mcp",
  "repository": {
    "url": "https://github.com/PSA-Team-source/uberllm",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://uberllm.dev/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.uberllm.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your UberLLM API key, sent as a Bearer token. Create one at https://uberllm.dev/dashboard/keys",
          "isRequired": true,
          "value": "Bearer {api_key}",
          "variables": {
            "api_key": {
              "description": "UberLLM API key (starts with ull_)",
              "isRequired": true,
              "isSecret": true,
              "placeholder": "ull_..."
            }
          }
        }
      ]
    }
  ]
}
