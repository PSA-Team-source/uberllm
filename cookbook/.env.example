# Copy to .env (never commit it) or export these in your shell.
# Create a key at https://uberllm.dev (Dashboard -> API keys). Keys start with ull_.
UBERLLM_API_KEY=ull_your_key_here

# Optional: override the model an example uses. Ids: https://uberllm.dev/models
# UBERLLM_MODEL=deepseek/deepseek-v4-flash
